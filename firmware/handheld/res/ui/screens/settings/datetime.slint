import { Theme } from "../../theme.slint";
import { Backend } from "../../common.slint";
import { SettingDatetime } from "types.slint";

export component DatetimePicker {
    in property <SettingDatetime> dt;
    in property <bool> selected: false;
    in property <int> part: 0;

    protected pure function pad(val: int, pad: string) -> string {
        if val < 10 {
            "\{pad}\{val}"
        } else {
            val
        }
    }

    HorizontalLayout {
        Text {
            text: dt.year;
            color: part == 0 || !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: "-";
            color: !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: pad(dt.month, " ");
            color: part == 1 || !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: "-";
            color: !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: pad(dt.day, " ");
            color: part == 2 || !selected ? Theme.text : Theme.text-dim;
        }

        Rectangle {
            width: 8px;
        }

        Text {
            text: Backend.time-24h ? pad(dt.hour, "0") : pad(dt.hour > 12 ? dt.hour - 12 : dt.hour == 0 ? 12 : dt.hour, " ");
            color: part == 3 || !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: ":";
            color: !selected ? Theme.text : Theme.text-dim;
        }

        Text {
            text: pad(dt.min, "0");
            color: part == 4 || !selected ? Theme.text : Theme.text-dim;
        }

        if !Backend.time-24h: Text {
            text: dt.hour >= 12 ? "PM" : "AM";
            color: !selected ? Theme.text : Theme.text-dim;
        }
    }
}
