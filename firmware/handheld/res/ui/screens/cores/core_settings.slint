import { Theme } from "../../theme.slint";
import { Backend } from "../../common.slint";
import { ListView } from "../../components/list_view.slint";
import { CoreSetting, CoreSettingType } from "types.slint";
import { Icons } from "../../icons.slint";
import { ScrollingText } from "../../components/scrolling_text.slint";
import { OutlinedText, OutlinedImage, OutlinedFrame } from "../../components/outline.slint";

// Drawn over the darkened game, like the Cheats page (see OverlayColors in game.slint).
global SettingsColors {
    out property <color> text: white;
}

// GB-173: the box is as wide as the current choice (not the widest one), and the arrows take
// space only while the row is selected, so the setting's label keeps as much room as possible.
// Display only: CoreSettingList changes the value on left / right.
component ListBox {
    in property <int> index;
    in property <[string]> choices;
    in property <bool> focused;

    HorizontalLayout {
        spacing: 2px;

        if root.focused: OutlinedImage {
            source: Icons.left-caret;
            tint: SettingsColors.text;
        }

        OutlinedText {
            text-color: SettingsColors.text;
            text: root.index >= 0 && root.index < root.choices.length ? root.choices[root.index] : "";
        }

        if root.focused: OutlinedImage {
            source: Icons.right-caret;
            tint: SettingsColors.text;
        }
    }

}

component CoreSettingListItem {
    in property <CoreSetting> item;
    in property <bool> selected;

    if selected: OutlinedFrame {
        x: 1px;
        y: 1px;
        width: root.width - 2px;
        height: root.height - 2px;
        line-color: SettingsColors.text;
    }

    // GB-173: the label gets the width left of the value, elided, and scrolls while its row is
    // selected. Only the height comes from the text: the list gives the row its width, and nothing
    // read by the layout may depend on that width (see ScrollingText).
    private property <length> value-left: item.type == CoreSettingType.list
        ? i-list.x
        : item.type == CoreSettingType.checkbox ? root.width - (root.height - 4px) - 4px : root.width - 4px;

    // The rows are 20 px high (CoreSettingListBase).
    min-height: 20px;

    // GB-174: an outlined elided label on the rows, the scrolling one only on the selected row.
    if !root.selected: OutlinedText {
        x: 4px;
        width: max(0px, root.value-left - self.x - 6px);
        height: root.height;
        text: item.label;
        text-color: SettingsColors.text;
        elide: true;
    }
    if root.selected: ScrollingText {
        x: 4px;
        width: max(0px, root.value-left - self.x - 6px);
        text: item.label;
        active: true;
        text-color: SettingsColors.text;
        outline: true;
    }

    if item.type == CoreSettingType.checkbox: Rectangle {
        x: parent.width - self.width - 4px;
        width: self.height;
        height: parent.height - 4px;

        OutlinedFrame {
            line-color: SettingsColors.text;
        }

        Rectangle {
            visible: item.value != 0;
            x: 2px;
            y: 2px;
            width: parent.width - 4px;
            height: parent.height - 4px;
            background: SettingsColors.text;
        }
    }

    // Always present (empty and hidden for other types), so the label can read its position.
    i-list := ListBox {
        visible: item.type == CoreSettingType.list;
        x: parent.width - self.width - 4px;
        index: item.value;
        choices: item.type == CoreSettingType.list ? item.choices : [];
        focused: root.selected && item.type == CoreSettingType.list;
    }
}

component CoreSettingListBase inherits ListView {
    in property <[CoreSetting]> model: Backend.core-settings;
    num-items: model.length;
    current-item: 0;

    for item[index] in root.model: CoreSettingListItem {
        height: 20px;
        item: item;
        selected: index == root.current-item;
    }
}

export component CoreSettingList inherits FocusScope {
    horizontal-stretch: 1;
    vertical-stretch: 1;
    preferred-width: 100%;
    preferred-height: 100%;

    function set-current-value(entry: CoreSetting, val: int) {
        Backend.core-settings[i-list.current-item] = {
            id: entry.id,
            label: entry.label,
            type: entry.type,
            value: val,
            choices: entry.choices,
        };
        Backend.game-settings-set(entry.id, val);
    }

    function activate-item(entry: CoreSetting) {
        if (entry.type == CoreSettingType.action) {
            Backend.game-settings-set(entry.id, entry.value);
        } else if (entry.type == CoreSettingType.checkbox) {
            root.set-current-value(entry, (entry.value == 0) ? 1 : 0);
        }
    }

    // A list setting changes in place, over the game (GB-173): upstream's ChoicePopup is an opaque
    // white card, which the in-game overlay does not use.
    function step-choice(entry: CoreSetting, delta: int) {
        if (entry.type == CoreSettingType.list && entry.choices.length > 0) {
            if (clamp(entry.value + delta, 0, entry.choices.length - 1) != entry.value) {
                root.set-current-value(entry, clamp(entry.value + delta, 0, entry.choices.length - 1));
            }
        }
    }

    i-list := CoreSettingListBase {
        width: 100%;
        height: 100%;
    }

    key-pressed(event) => {
        if (event.text == Key.UpArrow) {
            i-list.select-up();
            return accept;
        }
        if (event.text == Key.DownArrow) {
            i-list.select-down();
            return accept;
        }
        if (event.text == "a" && !event.repeat && i-list.has-selection()) {
            root.activate-item(i-list.model[i-list.current-item]);
            return accept;
        }
        if (event.text == Key.LeftArrow && i-list.has-selection()) {
            root.step-choice(i-list.model[i-list.current-item], -1);
            return accept;
        }
        if (event.text == Key.RightArrow && i-list.has-selection()) {
            root.step-choice(i-list.model[i-list.current-item], 1);
            return accept;
        }
        reject
    }
}
