import { Theme } from "../../theme.slint";
import { Backend, Global } from "../../common.slint";
import { FileListView } from "../../components/file_list.slint";
import { ListContainer } from "../../components/list_view.slint";
import { ControlHint } from "../../components/control_hint.slint";
import { ButtonList } from "../../components/button_list.slint";

export component CoreFileSelect {
    private property <bool> has-error: Backend.core-file-select-error != "";

    callback on-cancel();

    forward-focus: list;

    // TODO: correctly label new item when the list changes

    // Hack to call set-current-item when the backend forces a new item.
    private property <int> _selected-index: Backend.core-file-select-index;
    changed _selected-index => {
        list.set-current-item(Backend.core-file-select-index);
    }

    // GB-162: the question for a game of a system with "Dual Core Link" on.
    private property <bool> ask: Backend.core-file-select-ask;
    changed ask => {
        if (ask) {
            i-ask-list.focused-item = 0;
            i-ask-list.focus();
        } else {
            list.focus();
        }
    }

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (Backend.core-file-select-is-loading) {
                accept
            } else if (ask) {
                if (event.text == "b" && !event.repeat) {
                    Backend.core-file-select-answer(-1);
                }
                accept
            } else if (has-error) {
                if (event.text == "a" || event.text == "b") {
                    Backend.core-file-select-error = "";
                    list.set-current-item(Backend.core-file-select-index);
                }
                accept
            } else if (event.text == "b" && !event.repeat) {
                Backend.core-file-select-up();
                accept
            } else {
                reject
            }
        }
        key-released(event) => {
            if (event.text == "Home") {
                on-cancel();
                accept
            } else {
                reject
            }
        }
        VerticalLayout {
            height: 100%;
            spacing: 2px;

            Text {
                color: Theme.fg;
                text: Backend.core-file-select-path;
            }

            ListContainer {
                viewport-y: list.viewport-y;
                viewport-height: list.viewport-height;
                visible-height: list.height;

                list := FileListView {
                    model: Backend.core-file-select-list;
                    wrap: true;
                    disabled: Backend.core-file-select-is-loading || has-error || ask;
                    on-item-selected(i) => {
                        Backend.core-file-select-index = i;
                        Backend.core-file-select-selected(i);
                    }
                    current-item-changed(i) => {
                        // TODO
                    }
                }
            }

            HorizontalLayout {
                alignment: space-between;

                ControlHint {
                    label: "Back";
                    button: "home";
                }

                ControlHint {
                    label: "Up";
                    button: "b";
                }

                ControlHint {
                    label: "Select";
                    button: "a";
                }
            }
        }

        Rectangle {
            visible: ask && !Backend.core-file-select-is-loading;
            background: Theme.surface;
            border-color: Theme.border;
            border-width: 1px;
            width: i-ask-list.min-width;
            height: i-ask-list.min-height;

            i-ask-list := ButtonList {
                items: ["Play", "Dual Core Link"];
                on-selected(item) => {
                    Backend.core-file-select-answer(item);
                }
            }
        }
    }

    if Backend.core-file-select-is-loading:  Rectangle {
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        width: i-layout.min-width;
        height: i-layout.min-height;

        i-layout := VerticalLayout {
            padding: 8px;
            spacing: 4px;
            i-text := Text {
                color: Theme.fg;
                horizontal-alignment: center;
                text: "Loading...";
            }
        }
    }

    if has-error: Rectangle {
        background: Theme.surface;
        border-color: Theme.border;
        border-width: 1px;
        width: min(self.preferred-width, parent.width - 16px);
        height: min(self.preferred-height, parent.height - 32px);

        i-error-layout := VerticalLayout {
            padding: 8px;
            spacing: 4px;
            Text {
                color: Theme.fg;
                horizontal-alignment: center;
                text: Backend.core-file-select-error;
                overflow: elide;
            }
        }
    }
}
