import { Theme } from "../theme.slint";
import { ListView } from "list_view.slint";
import { Icons } from "../icons.slint";
import { ScrollingText } from "scrolling_text.slint";

export enum FileIcon {
    blank,
    folder,
    nope,
}

export struct FileListEntry {
    name: string,
    icon: FileIcon,
}

component FileListItem {
    in property <FileListEntry> entry;
    in property <bool> is-selected;
    height: i-text.min-height;

    pure function iconToImage(icon: FileIcon) -> image {
        if (icon == FileIcon.folder) {
            Icons.folder
        } else if (icon == FileIcon.nope) {
            Icons.nope
        } else {
            Icons.empty
        }
    }

    i-highlight := Rectangle {
        width: root.width;
        height: root.height;
        background: is-selected ? Theme.highlight : transparent;
    }

    Image {
        visible: entry.icon != FileIcon.blank;
        x: 1px;
        width: 8px;
        height: 8px;
        source: iconToImage(entry.icon);
        colorize: Theme.icon;
    }

    // GB-174: a plain elided Text on every row; the scrolling text (several texts and a timer, ~150
    // allocations) only on the selected row. Every visible row used to hold one, ~45 KB in >1200
    // pieces for the file list, kept while a game runs.
    i-text := Text {
        x: 12px;
        // Limit the maximum width of text to save memory with many long filenames.
        width: min(250px, parent.width - self.x);
        text: entry.name;
        overflow: elide;
        vertical-alignment: center;
        visible: !is-selected;
    }

    // Scroll the name of the selected file if it doesn't fit.
    if is-selected: ScrollingText {
        x: 12px;
        width: min(250px, parent.width - self.x);
        text: entry.name;
        active: true;
    }
}

component FileListViewBase inherits ListView {
    in property <[FileListEntry]> model;
    num-items: model.length;

    for item[index] in root.model: FileListItem {
        height: 15px; // N.B. Setting this to self.min-height doesn't work.
        entry: item;
        is-selected: index == root.current-item;
    }
}

export component FileListView inherits FileListViewBase {
    in property <bool> disabled: false;
    callback on-item-selected(/* selected-item */ int);

    forward-focus: i-focus-scope;

    i-focus-scope := FocusScope {
        key-pressed(event) => {
            if (disabled) {
                return reject;
            } else if (event.text == Key.UpArrow) {
                root.select-up();
                return accept;
            } else if (event.text == Key.DownArrow) {
                root.select-down();
                return accept;
            } else if (event.text == "a" && !event.repeat && root.has-selection()) {
                root.on-item-selected(root.current-item);
                return accept;
            } else if (event.text == "l") {
                root.select-page-up();
                return accept;
            } else if (event.text == "r") {
                root.select-page-down();
                return accept;
            }
            reject
        }
    }
}
