// Light text, icons and frames over the game, for the in-game menu (GB-173). The 1 px black
// outline is not drawn here: the firmware adds it to the in-game overlay after rendering (every
// transparent pixel next to a gray or white one becomes black, src/ui/mod.rs). Drawing it here
// (an outline font copy, eight shifted icons, three rectangles per frame) doubled the memory of
// the in-game Settings panel and ran the console out of memory (GB-181).

// Sizes come from the Text itself: its preferred size is its natural size, independent of the
// width it is given (see ScrollingText).
export component OutlinedText inherits Rectangle {
    in property <string> text;
    in property <brush> text-color: white;
    in property <brush> outline-color: black;
    in property <TextHorizontalAlignment> horizontal-alignment: TextHorizontalAlignment.left;
    in property <TextVerticalAlignment> vertical-alignment: TextVerticalAlignment.center;
    // Elide when it does not fit.
    in property <bool> elide: false;

    preferred-width: i-text.preferred-width;
    preferred-height: i-text.preferred-height;
    min-height: i-text.min-height;

    i-text := Text {
        x: 0px;
        y: 0px;
        width: root.width;
        height: root.height;
        text: root.text;
        color: root.text-color;
        horizontal-alignment: root.horizontal-alignment;
        vertical-alignment: root.vertical-alignment;
        overflow: root.elide ? TextOverflow.elide : TextOverflow.clip;
    }
}

export component OutlinedImage inherits Rectangle {
    in property <image> source;
    in property <brush> tint: white;
    in property <brush> outline-color: black;

    preferred-width: i-main.preferred-width;
    preferred-height: i-main.preferred-height;

    i-main := Image {
        source: root.source;
        colorize: root.tint;
    }
}

// A 1 px light frame (the firmware outlines it on both sides).
export component OutlinedFrame inherits Rectangle {
    in property <brush> line-color: white;
    in property <brush> outline-color: black;

    Rectangle {
        border-width: 1px;
        border-color: root.line-color;
    }
}
